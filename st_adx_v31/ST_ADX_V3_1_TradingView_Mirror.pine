//@version=6
indicator("ST-ADX V3.1 | TradingView Signal Mirror", overlay=true, max_labels_count=300, max_lines_count=30)

// IMPORTANT:
// This script mirrors ST-ADX V3.1 signal calculations on the selected TradingView feed.
// GitHub paper_state.json remains the authority for actual paper positions, fills, equity and exits.
// Pine Script cannot fetch GitHub JSON or Telegram state directly. Use a BingX USDT perpetual chart on 1H.

if barstate.isfirst and timeframe.period != "60"
    runtime.error("ST-ADX V3.1 must run on a 1H chart.")

string base = syminfo.basecurrency
var string[] longAllow = array.from("ENA","XRP","ZEC","TIA","ORDI","AKE","WIF","APR","XLM","VIRTUAL","DYDX")
var string[] shortAllow = array.from("ARB","AVAX","BTC","ENA","ETH","LINK","NEAR","SOL","SUI","UNI","XRP","DOT","LTC","ADA")
bool allowLong = array.includes(longAllow, base)
bool allowShort = array.includes(shortAllow, base)

// ST-ADX V3.1 parameters — kept equal to st_adx_v31/strategy_core.py
int stLength = 12
float stFactor = 2.8
int dmiLength = 40
int adxSmoothing = 40
float adxMin = 30.0
int rsiLength = 12
int emaLength = 53
int atrRiskLength = 10
float slAtr = 1.2
float tpAtr = 3.5
float entrySlip = 0.0002

[stLine, stDirection] = ta.supertrend(stFactor, stLength)
[diPlus, diMinus, adx] = ta.dmi(dmiLength, adxSmoothing)
float rsi = ta.rsi(close, rsiLength)
float ema53 = ta.ema(close, emaLength)
float atr10 = ta.atr(atrRiskLength)

bool bull = stDirection < 0
bool bear = stDirection > 0
bool flipBull = bull and stDirection[1] > 0
bool flipBear = bear and stDirection[1] < 0
bool adxRising = adx > adx[1] and adx[1] > adx[2]
bool strong = adx > adxMin and adxRising
bool bullCandle = close > open or flipBull
bool bearCandle = close < open or flipBear
bool aboveEma = close > ema53
bool belowEma = close < ema53

bool longSetup = allowLong and bull and strong and rsi > 50 and bullCandle and (aboveEma or flipBull)
bool shortSetup = allowShort and bear and strong and rsi < 50 and bearCandle and (belowEma or flipBear)
bool longClosed = barstate.isconfirmed and longSetup
bool shortClosed = barstate.isconfirmed and shortSetup

// GitHub runner enters at the NEXT 1H candle open, with 2 bps adverse entry slippage.
// Therefore levels are calculated on the first update of the candle after a confirmed setup.
bool longEntryBar = longClosed[1] and barstate.isnew
bool shortEntryBar = shortClosed[1] and barstate.isnew
float longEntry = open * (1 + entrySlip)
float shortEntry = open * (1 - entrySlip)
float longSL = longEntry - atr10[1] * slAtr
float longTP = longEntry + atr10[1] * tpAtr
float shortSL = shortEntry + atr10[1] * slAtr
float shortTP = shortEntry - atr10[1] * tpAtr

var line entryLine = na
var line stopLine = na
var line targetLine = na
var label entryLabel = na

if longEntryBar or shortEntryBar
    if not na(entryLine)
        line.delete(entryLine)
    if not na(stopLine)
        line.delete(stopLine)
    if not na(targetLine)
        line.delete(targetLine)
    if not na(entryLabel)
        label.delete(entryLabel)
    float e = longEntryBar ? longEntry : shortEntry
    float s = longEntryBar ? longSL : shortSL
    float t = longEntryBar ? longTP : shortTP
    string side = longEntryBar ? "LONG" : "SHORT"
    color sideColor = longEntryBar ? color.lime : color.red
    entryLine := line.new(bar_index, e, bar_index + 20, e, color=color.yellow, width=2)
    stopLine := line.new(bar_index, s, bar_index + 20, s, color=color.red, width=2)
    targetLine := line.new(bar_index, t, bar_index + 20, t, color=color.aqua, width=2)
    entryLabel := label.new(bar_index, e, "CHART MIRROR " + side + "\nEntry " + str.tostring(e, format.mintick) + "\nSL " + str.tostring(s, format.mintick) + "\nTP " + str.tostring(t, format.mintick), style=label.style_label_left, color=sideColor, textcolor=color.black)

plot(stLine, "SuperTrend 12 / 2.8", color=stDirection < 0 ? color.lime : color.red, linewidth=2)
plot(ema53, "EMA 53", color=color.orange)
plotshape(longClosed, title="ST-ADX LONG setup", text="ST-ADX\nLONG", style=shape.labelup, location=location.belowbar, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(shortClosed, title="ST-ADX SHORT setup", text="ST-ADX\nSHORT", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)

var table dash = table.new(position.top_right, 2, 10, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "ST-ADX V3.1", bgcolor=color.rgb(25,32,43), text_color=color.white)
    table.cell(dash, 1, 0, "CHART MIRROR", bgcolor=color.rgb(25,32,43), text_color=color.yellow)
    table.cell(dash, 0, 1, "SYMBOL / TF")
    table.cell(dash, 1, 1, base + " / " + timeframe.period)
    table.cell(dash, 0, 2, "ALLOWLIST")
    table.cell(dash, 1, 2, allowLong ? "LONG" : allowShort ? "SHORT" : "NOT ENABLED", text_color=(allowLong or allowShort) ? color.lime : color.gray)
    table.cell(dash, 0, 3, "SUPERTREND")
    table.cell(dash, 1, 3, bull ? "BULL" : "BEAR", text_color=bull ? color.lime : color.red)
    table.cell(dash, 0, 4, "ADX / RISING")
    table.cell(dash, 1, 4, str.tostring(adx, "#.00") + (adxRising ? " / YES" : " / NO"))
    table.cell(dash, 0, 5, "RSI 12")
    table.cell(dash, 1, 5, str.tostring(rsi, "#.00"))
    table.cell(dash, 0, 6, "EMA 53")
    table.cell(dash, 1, 6, close > ema53 ? "PRICE ABOVE" : "PRICE BELOW")
    table.cell(dash, 0, 7, "SIGNAL")
    table.cell(dash, 1, 7, longSetup ? "LONG SETUP" : shortSetup ? "SHORT SETUP" : "WAIT", text_color=longSetup ? color.lime : shortSetup ? color.red : color.gray)
    table.cell(dash, 0, 8, "ATR10")
    table.cell(dash, 1, 8, str.tostring(atr10, format.mintick))
    table.cell(dash, 0, 9, "POSITION STATE")
    table.cell(dash, 1, 9, "CHECK GITHUB PAPER STATE", text_color=color.yellow)

alertcondition(longClosed, "ST-ADX V3.1 LONG setup", "ST-ADX V3.1 LONG setup | {{ticker}} | TF={{interval}} | close={{close}}")
alertcondition(shortClosed, "ST-ADX V3.1 SHORT setup", "ST-ADX V3.1 SHORT setup | {{ticker}} | TF={{interval}} | close={{close}}")

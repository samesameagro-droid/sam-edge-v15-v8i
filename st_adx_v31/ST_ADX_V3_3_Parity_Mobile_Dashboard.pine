//@version=6
strategy("ST-ADX V3.3 | Strategy + Mobile Dashboard", overlay=true, initial_capital=100, currency=currency.USDT, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.05, process_orders_on_close=false, calc_on_order_fills=false)

// ST-ADX V3.3 Python parity mirror.
// Scope: one symbol + one directional model per chart. This does NOT reproduce
// the 23-coin portfolio's aggregate risk cap or portfolio-level equity curve.
// Use BingX USDT perpetual, 1H. GitHub/Python remains portfolio source of truth.

if barstate.isfirst and timeframe.period != "60"
    runtime.error("Gunakan timeframe 1H (60 menit).")

// ─────────────────────────────────────────────────────────────────────────────
// Inputs (defaults equal strategy_core.py + research_150_universe_v33.py)
// ─────────────────────────────────────────────────────────────────────────────
string sideMode = input.string("AUTO", "Model arah", options=["AUTO", "LONG", "SHORT"])
bool useAllowlist = input.bool(true, "Batasi ke allowlist V3.3")
float initialEquity = input.float(100.0, "Modal awal (USDT)", minval=1)
float riskPct = input.float(1.0, "Risiko per trade (%)", minval=0.1, maxval=5, step=0.1) / 100
float notionalCapPct = input.float(45.0, "Batas notional (% equity)", minval=1, maxval=100) / 100
float feeRate = input.float(0.05, "Fee per sisi (%)", minval=0, step=0.01) / 100
float slipRate = input.float(0.02, "Slippage adverse (bps)", minval=0, step=0.01) / 10000

int stLength = input.int(12, "Supertrend length")
float stFactor = input.float(2.8, "Supertrend multiplier")
int dmiLength = input.int(40, "DMI length")
int adxSmoothing = input.int(40, "ADX smoothing")
float adxMin = input.float(30, "ADX minimum")
int rsiLength = input.int(12, "RSI length")
int emaLength = input.int(53, "EMA length")
float rsiLongMin = input.float(60, "LONG RSI min")
float rsiLongMax = input.float(70, "LONG RSI max")
float rsiShortMin = input.float(35, "SHORT RSI min")
float rsiShortMax = input.float(40, "SHORT RSI max")
float shortMaxExtension = input.float(3.25, "SHORT max EMA extension (ATR)")
int atrLength = input.int(10, "ATR risk length")
float slATR = input.float(1.2, "SL ATR")
float tpATR = input.float(3.5, "TP ATR")

// ─────────────────────────────────────────────────────────────────────────────
// Allowlist
// ─────────────────────────────────────────────────────────────────────────────
var string[] longCoins = array.from("ENA","XRP","ZEC","TIA","ORDI","AKE","WIF","APR","XLM","VIRTUAL","DYDX")
var string[] shortCoins = array.from("ARB","AVAX","BTC","ENA","ETH","LINK","NEAR","SOL","SUI","UNI","XRP","DOT","LTC","ADA")
string base = str.upper(syminfo.basecurrency)
bool longAllowed = array.includes(longCoins, base)
bool shortAllowed = array.includes(shortCoins, base)
string selectedSide = sideMode == "AUTO" ? (longAllowed ? "LONG" : "SHORT") : sideMode
bool sideAllowed = selectedSide == "LONG" ? longAllowed : shortAllowed
bool modelEnabled = not useAllowlist or sideAllowed

// ─────────────────────────────────────────────────────────────────────────────
// Indicators — mirror Python strategy_core.add_indicators
// ─────────────────────────────────────────────────────────────────────────────
[stLine, stDirection] = ta.supertrend(stFactor, stLength)
[diPlus, diMinus, adx] = ta.dmi(dmiLength, adxSmoothing)
float rsi = ta.rsi(close, rsiLength)
float ema53 = ta.ema(close, emaLength)
float atrRisk = ta.atr(atrLength)

bool bull = stDirection < 0
bool bear = stDirection > 0
bool flipBull = bull and stDirection[1] > 0
bool flipBear = bear and stDirection[1] < 0
bool adxRising = adx > adx[1] and adx[1] > adx[2]
bool strong = adx > adxMin and adxRising
bool bullCandle = close > open or flipBull
bool bearCandle = close < open or flipBear
bool aboveEMA = close > ema53
bool belowEMA = close < ema53
float shortExtensionATR = atrRisk > 0 ? (ema53 - close) / atrRisk : na

bool longSignal = modelEnabled and selectedSide == "LONG" and bull and strong and rsi >= rsiLongMin and rsi <= rsiLongMax and bullCandle and (aboveEMA or flipBull)
bool shortSignal = modelEnabled and selectedSide == "SHORT" and bear and strong and rsi >= rsiShortMin and rsi <= rsiShortMax and shortExtensionATR <= shortMaxExtension and bearCandle and (belowEMA or flipBear)
bool signal = barstate.isconfirmed and (longSignal or shortSignal)

// ─────────────────────────────────────────────────────────────────────────────
// Native TradingView Strategy Tester execution.
// One symbol per chart; this is not the 23-coin portfolio aggregation.
// Entry at next bar open; SL/TP use ATR snapshot from signal candle.
// ─────────────────────────────────────────────────────────────────────────────
var float tradeATR = na
var float activeSL = na
var float activeTP = na
var float activeTP1 = na
var float activeTP2 = na
var float activeTP3 = na
var label slTag = na
var label entryTag = na
var label tp1Tag = na
var label tp2Tag = na
var label tp3Tag = na
var string lastExitReason = "—"
var int lastClosedCount = 0

bool flat = strategy.position_size == 0
bool canEnter = barstate.isconfirmed and bar_index >= 250 and flat and signal

if canEnter
    tradeATR := atrRisk
    float stopDistance = atrRisk * slATR
    float riskPerUnit = stopDistance + close * feeRate * 2
    float riskBudget = strategy.equity * riskPct
    float notionalBudget = strategy.equity * notionalCapPct
    float orderQty = math.min(riskBudget / riskPerUnit, notionalBudget / close)
    if orderQty > 0 and not na(orderQty)
        if selectedSide == "LONG"
            strategy.entry("LONG", strategy.long, qty=orderQty)
        else
            strategy.entry("SHORT", strategy.short, qty=orderQty)

if strategy.position_size > 0 and not na(tradeATR)
    activeSL := strategy.position_avg_price - tradeATR * slATR
    activeTP := strategy.position_avg_price + tradeATR * tpATR
    activeTP1 := strategy.position_avg_price + tradeATR * slATR
    activeTP2 := strategy.position_avg_price + tradeATR * slATR * 2.0
    activeTP3 := strategy.position_avg_price + tradeATR * slATR * 3.0
    strategy.exit("LONG SL/TP", from_entry="LONG", stop=activeSL, limit=activeTP)
    if stDirection > 0 and barstate.isconfirmed
        lastExitReason := "ST FLIP"
        strategy.close("LONG", comment="ST FLIP")

if strategy.position_size < 0 and not na(tradeATR)
    activeSL := strategy.position_avg_price + tradeATR * slATR
    activeTP := strategy.position_avg_price - tradeATR * tpATR
    activeTP1 := strategy.position_avg_price - tradeATR * slATR
    activeTP2 := strategy.position_avg_price - tradeATR * slATR * 2.0
    activeTP3 := strategy.position_avg_price - tradeATR * slATR * 3.0
    strategy.exit("SHORT SL/TP", from_entry="SHORT", stop=activeSL, limit=activeTP)
    if stDirection < 0 and barstate.isconfirmed
        lastExitReason := "ST FLIP"
        strategy.close("SHORT", comment="ST FLIP")

if strategy.closedtrades > lastClosedCount
    int idx = strategy.closedtrades - 1
    string exitComment = strategy.closedtrades.exit_comment(idx)
    lastExitReason := exitComment == "" ? "SL / TP" : exitComment
    lastClosedCount := strategy.closedtrades
    tradeATR := na
    activeSL := na
    activeTP := na
    activeTP1 := na
    activeTP2 := na
    activeTP3 := na

float winRate = strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : 0.0
float profitFactor = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : (strategy.grossprofit > 0 ? 999.0 : 0.0)
float maxDrawdownPct = strategy.initial_capital > 0 ? strategy.max_drawdown / strategy.initial_capital * 100.0 : 0.0
// ─────────────────────────────────────────────────────────────────────────────
// Chart visuals
// ─────────────────────────────────────────────────────────────────────────────
plot(stLine, "Supertrend 12/2.8", color=bull ? color.lime : color.red, linewidth=2)
plot(ema53, "EMA 53", color=color.orange, linewidth=1)
plotshape(signal and selectedSide == "LONG", title="Confirmed V3.3 LONG", style=shape.triangleup, location=location.belowbar, color=color.lime, text="LONG", textcolor=color.white, size=size.tiny)
plotshape(signal and selectedSide == "SHORT", title="Confirmed V3.3 SHORT", style=shape.triangledown, location=location.abovebar, color=color.red, text="SHORT", textcolor=color.white, size=size.tiny)

// Clean trade-plan overlay: exactly one SL, Entry and one final TP.
// TP is the V3.3 final target (3.5 ATR); no partial TP levels.
var line slLine = na
var line entryLine = na
var line tpLine = na
var label slLabel = na
var label entryLabel = na
var label tpLabel = na

f_trade_pct(float level, float entry) =>
    na(level) or na(entry) or entry == 0 ? "—" : str.tostring(math.abs(level - entry) / entry * 100.0, "#.##") + "%"

if barstate.islast
    line.delete(slLine)
    line.delete(entryLine)
    line.delete(tpLine)
    label.delete(slLabel)
    label.delete(entryLabel)
    label.delete(tpLabel)
    if strategy.position_size != 0 and not na(activeSL) and not na(activeTP)
        int x1 = math.max(0, bar_index - 12)
        int x2 = bar_index + 5
        float e = strategy.position_avg_price
        bool isLong = strategy.position_size > 0
        string slMove = "-" + f_trade_pct(activeSL, e)
        string tpMove = "+" + f_trade_pct(activeTP, e)
        slLine := line.new(x1, activeSL, x2, activeSL, color=color.red, width=2)
        entryLine := line.new(x1, e, x2, e, color=color.gray, width=2)
        tpLine := line.new(x1, activeTP, x2, activeTP, color=color.lime, width=2)
        slLabel := label.new(x2, activeSL, "SL  " + str.tostring(activeSL, format.mintick) + " (" + slMove + ")", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
        entryLabel := label.new(x2, e, "ENTRY  " + str.tostring(e, format.mintick), style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.small)
        tpLabel := label.new(x2, activeTP, "TP  " + str.tostring(activeTP, format.mintick) + " (+" + f_trade_pct(activeTP, e) + ")", style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// Compact mobile dashboard (top-right; 2 columns, short labels)
// ─────────────────────────────────────────────────────────────────────────────
f_fmt(float v) => na(v) ? "—" : str.tostring(v, "#.##")
f_status(bool ok) => ok ? "PASS" : "WAIT"
f_status_color(bool ok) => ok ? color.lime : color.orange



string trendText = bull ? "BULL" : "BEAR"
bool directionTrend = selectedSide == "LONG" ? bull : bear
bool directionRsi = selectedSide == "LONG" ? (rsi >= rsiLongMin and rsi <= rsiLongMax) : (rsi >= rsiShortMin and rsi <= rsiShortMax)
bool directionCandle = selectedSide == "LONG" ? bullCandle : bearCandle
bool directionEMA = selectedSide == "LONG" ? (aboveEMA or flipBull) : (belowEMA or flipBear)
bool directionExtension = selectedSide == "LONG" or shortExtensionATR <= shortMaxExtension
bool ready = modelEnabled and directionTrend and strong and directionRsi and directionCandle and directionEMA and directionExtension

var table dash = table.new(position.top_right, 2, 15, bgcolor=color.rgb(17,24,39), frame_color=color.rgb(71,85,105), frame_width=1, border_color=color.rgb(51,65,85), border_width=1)
f_check(bool ok) => ok ? "✓ OK" : "✕ NO"
f_check_color(bool ok) => ok ? color.lime : color.red
if barstate.islast
    color head = color.rgb(30,41,59)
    table.cell(dash, 0, 0, "ST-ADX V3.3", text_color=color.white, bgcolor=head, text_size=size.small)
    table.cell(dash, 1, 0, base + " / " + selectedSide, text_color=selectedSide == "LONG" ? color.lime : color.red, bgcolor=head, text_size=size.small)
    table.cell(dash, 0, 1, "SIGNAL CHECKLIST", text_color=color.white, bgcolor=head, text_size=size.tiny)
    table.cell(dash, 1, 1, ready ? "✓ ALL PASS" : "WAIT", text_color=ready ? color.lime : color.orange, bgcolor=head, text_size=size.tiny)
    table.cell(dash, 0, 2, "Allowlist", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2, f_check(modelEnabled), text_color=f_check_color(modelEnabled), text_size=size.tiny)
    table.cell(dash, 0, 3, "Supertrend " + trendText, text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, f_check(directionTrend), text_color=f_check_color(directionTrend), text_size=size.tiny)
    table.cell(dash, 0, 4, "ADX > " + str.tostring(adxMin), text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, f_fmt(adx) + " / " + f_check(adx > adxMin), text_color=f_check_color(adx > adxMin), text_size=size.tiny)
    table.cell(dash, 0, 5, "ADX naik 2 bar", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, f_check(adxRising), text_color=f_check_color(adxRising), text_size=size.tiny)
    table.cell(dash, 0, 6, "RSI range", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 6, f_fmt(rsi) + " / " + f_check(directionRsi), text_color=f_check_color(directionRsi), text_size=size.tiny)
    table.cell(dash, 0, 7, "Candle confirm", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 7, f_check(directionCandle), text_color=f_check_color(directionCandle), text_size=size.tiny)
    table.cell(dash, 0, 8, "EMA 53", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 8, f_check(directionEMA), text_color=f_check_color(directionEMA), text_size=size.tiny)
    table.cell(dash, 0, 9, "SHORT ext <= 3.25 ATR", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 9, selectedSide == "LONG" ? "N/A" : f_fmt(shortExtensionATR) + " / " + f_check(directionExtension), text_color=f_check_color(directionExtension), text_size=size.tiny)
    table.cell(dash, 0, 10, "SETUP", text_color=color.white, bgcolor=head, text_size=size.tiny)
    table.cell(dash, 1, 10, ready ? "✓ VALID" : "NOT READY", text_color=ready ? color.lime : color.orange, bgcolor=head, text_size=size.tiny)
    table.cell(dash, 0, 11, "Trade / Win%", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 11, str.tostring(strategy.closedtrades) + " / " + f_fmt(winRate) + "%", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 12, "PF / Max DD", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 12, f_fmt(profitFactor) + " / " + f_fmt(maxDrawdownPct) + "%", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 13, "Net / Equity", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 13, f_fmt(strategy.netprofit) + " / " + f_fmt(strategy.equity), text_color=strategy.netprofit >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(dash, 0, 14, "Position", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 14, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color=strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.silver, text_size=size.tiny)

alertcondition(signal, "ST-ADX V3.3 confirmed", "ST-ADX V3.3 | {{ticker}} | {{interval}} | close={{close}}")

//@version=6
indicator("SAM EDGE V15 | ADX4H + CANDLE2H | STATEFUL", overlay=true, max_labels_count=500, max_lines_count=100)

// ============================================================================
// SAM EDGE V15 — STATEFUL TRADE TRACKER
// Execution : 15M CLOSED BAR
// Structure : completed 1H + completed 4H
// Regime    : completed 4H ADX
// Candle    : completed 2H STRICT
// ============================================================================

if barstate.isfirst and timeframe.period != "15"
    runtime.error("SAM EDGE V15 must run on a 15-minute chart.")

groupCore = "SAM EDGE V15 | CORE"
adxLen = input.int(14, "ADX Length", minval=2, group=groupCore)
adxLookback = input.int(200, "4H ADX Percentile Lookback", minval=50, group=groupCore)
rsiLen = input.int(14, "RSI Length", minval=2, group=groupCore)
atrLen = input.int(14, "ATR Length", minval=2, group=groupCore)
emaFastLen = input.int(20, "EMA Fast", minval=2, group=groupCore)
emaSlowLen = input.int(50, "EMA Slow", minval=2, group=groupCore)
rr = input.float(1.25, "TP / RR", step=0.05, group=groupCore)

groupADX = "SAM EDGE V15 | 4H ADX GATE"
adxLongPct = input.float(0.80, "LONG ADX percentile", minval=0, maxval=1, step=0.01, group=groupADX)
adxLongDelta = input.float(0.75, "LONG ADX delta", step=0.05, group=groupADX)
adxShortPct = input.float(0.85, "SHORT ADX percentile", minval=0, maxval=1, step=0.01, group=groupADX)
adxShortDelta = input.float(0.90, "SHORT ADX delta", step=0.05, group=groupADX)

groupCandle = "SAM EDGE V15 | 2H STRICT CANDLE"
cBodyMin = input.float(0.55, "Body / ATR minimum", step=0.05, group=groupCandle)
cCloseBull = input.float(0.78, "Bull close position minimum", step=0.01, group=groupCandle)
cCloseBear = input.float(0.22, "Bear close position maximum", step=0.01, group=groupCandle)
cWickMax = input.float(0.20, "Opposite wick maximum", step=0.01, group=groupCandle)
cRangeMaxATR = input.float(2.00, "2H range / ATR maximum", step=0.05, group=groupCandle)

groupVisual = "SAM EDGE V15 | VISUAL"
showMainLines = input.bool(true, "Show EMA20 / EMA50 / VWAP", group=groupVisual)
showHTFLines = input.bool(false, "Show 1H / 4H EMA21", group=groupVisual)
showBackground = input.bool(true, "Show HTF regime background", group=groupVisual)
showSignals = input.bool(true, "Show LONG / SHORT markers", group=groupVisual)
showLevels = input.bool(true, "Show active Entry / SL / TP", group=groupVisual)
showDashboard = input.bool(true, "Show detailed V15 dashboard", group=groupVisual)
confirmedOnly = input.bool(true, "Confirmed 15M bars only", group="SAM EDGE V15 | MIRROR")

cEma20 = color.rgb(0,190,255)
cEma50 = color.rgb(255,190,0)
cVWAP = color.white
cH1 = color.rgb(165,100,255)
cH4 = color.rgb(255,90,90)
cLong = color.rgb(0,210,120)
cShort = color.rgb(255,70,80)
cEntry = color.rgb(255,235,0)
cSL = color.rgb(255,80,80)
cTP = color.rgb(0,230,160)
cPanel = color.rgb(22,27,35)
cMuted = color.rgb(160,170,185)
cPass = color.rgb(0,210,120)
cFail = color.rgb(210,80,90)

ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaSlowLen)
atr = ta.atr(atrLen)
rsi = ta.rsi(close, rsiLen)
vwap = ta.vwap(hlc3)

f_dmi_adx() =>
    _up = ta.change(high)
    _dn = -ta.change(low)
    _tr = ta.rma(ta.tr, adxLen)
    _plusDM = (_up > _dn and _up > 0) ? _up : 0.0
    _minusDM = (_dn > _up and _dn > 0) ? _dn : 0.0
    _pdi = 100.0 * ta.rma(_plusDM, adxLen) / math.max(_tr, syminfo.mintick)
    _mdi = 100.0 * ta.rma(_minusDM, adxLen) / math.max(_tr, syminfo.mintick)
    _dx = 100.0 * math.abs(_pdi - _mdi) / math.max(_pdi + _mdi, 1e-10)
    [_pdi, _mdi, ta.rma(_dx, adxLen)]

f_trend_bull() =>
    _e21 = ta.ema(close, 21)
    _e50 = ta.ema(close, 50)
    _e200 = ta.ema(close, 200)
    _e21 > _e50 and _e50 > _e200

f_trend_bear() =>
    _e21 = ta.ema(close, 21)
    _e50 = ta.ema(close, 50)
    _e200 = ta.ema(close, 200)
    _e21 < _e50 and _e50 < _e200

f_ema21() => ta.ema(close, 21)

[pdi, mdi, _adx15] = f_dmi_adx()
h1E21 = request.security(syminfo.tickerid, "60", f_ema21()[1], barmerge.gaps_off, barmerge.lookahead_off)
h4E21 = request.security(syminfo.tickerid, "240", f_ema21()[1], barmerge.gaps_off, barmerge.lookahead_off)
h1Bull = request.security(syminfo.tickerid, "60", f_trend_bull()[1], barmerge.gaps_off, barmerge.lookahead_off)
h1Bear = request.security(syminfo.tickerid, "60", f_trend_bear()[1], barmerge.gaps_off, barmerge.lookahead_off)
h4Bull = request.security(syminfo.tickerid, "240", f_trend_bull()[1], barmerge.gaps_off, barmerge.lookahead_off)
h4Bear = request.security(syminfo.tickerid, "240", f_trend_bear()[1], barmerge.gaps_off, barmerge.lookahead_off)
trendLong = h1Bull and h4Bull
trendShort = h1Bear and h4Bear

f_adx() =>
    _up = ta.change(high)
    _dn = -ta.change(low)
    _tr = ta.rma(ta.tr, adxLen)
    _plusDM = (_up > _dn and _up > 0) ? _up : 0.0
    _minusDM = (_dn > _up and _dn > 0) ? _dn : 0.0
    _pdi = 100.0 * ta.rma(_plusDM, adxLen) / math.max(_tr, syminfo.mintick)
    _mdi = 100.0 * ta.rma(_minusDM, adxLen) / math.max(_tr, syminfo.mintick)
    _dx = 100.0 * math.abs(_pdi - _mdi) / math.max(_pdi + _mdi, 1e-10)
    ta.rma(_dx, adxLen)

h4Adx = request.security(syminfo.tickerid, "240", f_adx()[1], barmerge.gaps_off, barmerge.lookahead_off)
h4AdxPct = request.security(syminfo.tickerid, "240", ta.percentrank(f_adx(), adxLookback)[1] / 100.0, barmerge.gaps_off, barmerge.lookahead_off)
h4AdxDelta = request.security(syminfo.tickerid, "240", (f_adx() - f_adx()[3])[1], barmerge.gaps_off, barmerge.lookahead_off)
adxLongOK = h4AdxPct >= adxLongPct and h4AdxDelta >= adxLongDelta
adxShortOK = h4AdxPct >= adxShortPct and h4AdxDelta >= adxShortDelta

swingH = ta.highest(high[1], 20)
swingL = ta.lowest(low[1], 20)
distEmaATR = math.abs(close - ema20) / math.max(atr, syminfo.mintick)
distResATR = (swingH - close) / math.max(atr, syminfo.mintick)
distSupATR = (close - swingL) / math.max(atr, syminfo.mintick)
roomLong = distResATR >= 0.85
roomShort = distSupATR >= 0.85
move5ATR = math.abs(close - close[5]) / math.max(atr, syminfo.mintick)
rangeATR = (high - low) / math.max(atr, syminfo.mintick)
noExhaustion = move5ATR <= 3.50 and distEmaATR <= 1.60 and rangeATR <= 2.25
emaLong = close > ema20 and ema20 > ema50
emaShort = close < ema20 and ema20 < ema50
structureLong = trendLong and emaLong and close > vwap and pdi > mdi and rsi >= 46 and rsi <= 64
structureShort = trendShort and emaShort and close < vwap and mdi > pdi and rsi >= 36 and rsi <= 54

f_strict_bull() =>
    _atr = ta.atr(atrLen)
    _rng = math.max(high-low, syminfo.mintick)
    _bodyATR = math.abs(close-open) / math.max(_atr, syminfo.mintick)
    _closePos = (close-low) / _rng
    _rangeATR = (high-low) / math.max(_atr, syminfo.mintick)
    _upperWick = (high-math.max(open,close)) / _rng
    close > open and _bodyATR >= cBodyMin and _closePos >= cCloseBull and _upperWick <= cWickMax and _rangeATR <= cRangeMaxATR

f_strict_bear() =>
    _atr = ta.atr(atrLen)
    _rng = math.max(high-low, syminfo.mintick)
    _bodyATR = math.abs(close-open) / math.max(_atr, syminfo.mintick)
    _closePos = (close-low) / _rng
    _rangeATR = (high-low) / math.max(_atr, syminfo.mintick)
    _lowerWick = (math.min(open,close)-low) / _rng
    close < open and _bodyATR >= cBodyMin and _closePos <= cCloseBear and _lowerWick <= cWickMax and _rangeATR <= cRangeMaxATR

c2hBull = request.security(syminfo.tickerid, "120", f_strict_bull()[1], barmerge.gaps_off, barmerge.lookahead_off)
c2hBear = request.security(syminfo.tickerid, "120", f_strict_bear()[1], barmerge.gaps_off, barmerge.lookahead_off)

longSignalRaw = structureLong and adxLongOK and roomLong and noExhaustion and c2hBull
shortSignalRaw = structureShort and adxShortOK and roomShort and noExhaustion and c2hBear
barOK = confirmedOnly ? barstate.isconfirmed : true
longSignal = longSignalRaw and barOK
shortSignal = shortSignalRaw and barOK

longSL = swingL - atr
longRisk = close - longSL
longTP = close + rr * longRisk
shortSL = swingH + atr
shortRisk = shortSL - close
shortTP = close - rr * shortRisk

// ============================================================================
// STATEFUL TRADE LOCK
// ============================================================================
var string activeSide = "NONE"
var float activeEntry = na
var float activeSL = na
var float activeTP = na
var int signalBar = na
var string levelStatus = "NONE"
var int exitBar = na
var string lastResult = "NONE"

newLongSignal = longSignal and not longSignal[1] and activeSide == "NONE"
newShortSignal = shortSignal and not shortSignal[1] and activeSide == "NONE"

var line entryLine = na
var line slLine = na
var line tpLine = na
var label entryLbl = na
var label slLbl = na
var label tpLbl = na
var label resultLbl = na

f_clear_levels() =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(entryLbl)
        label.delete(entryLbl)
    if not na(slLbl)
        label.delete(slLbl)
    if not na(tpLbl)
        label.delete(tpLbl)
    if not na(resultLbl)
        label.delete(resultLbl)

if showLevels and newLongSignal
    activeSide := "LONG"
    activeEntry := close
    activeSL := longSL
    activeTP := longTP
    signalBar := bar_index
    levelStatus := "ACTIVE"
    lastResult := "NONE"
    exitBar := na
    f_clear_levels()
    entryLine := line.new(bar_index, activeEntry, bar_index + 1, activeEntry, xloc=xloc.bar_index, color=cEntry, width=2)
    slLine := line.new(bar_index, activeSL, bar_index + 1, activeSL, xloc=xloc.bar_index, color=cSL, width=2)
    tpLine := line.new(bar_index, activeTP, bar_index + 1, activeTP, xloc=xloc.bar_index, color=cTP, width=2)
    entryLbl := label.new(bar_index, activeEntry, "ENTRY", xloc=xloc.bar_index, style=label.style_label_left, color=cEntry, textcolor=color.black, size=size.tiny)
    slLbl := label.new(bar_index, activeSL, "SL", xloc=xloc.bar_index, style=label.style_label_left, color=cSL, textcolor=color.white, size=size.tiny)
    tpLbl := label.new(bar_index, activeTP, "TP", xloc=xloc.bar_index, style=label.style_label_left, color=cTP, textcolor=color.black, size=size.tiny)

if showLevels and newShortSignal
    activeSide := "SHORT"
    activeEntry := close
    activeSL := shortSL
    activeTP := shortTP
    signalBar := bar_index
    levelStatus := "ACTIVE"
    lastResult := "NONE"
    exitBar := na
    f_clear_levels()
    entryLine := line.new(bar_index, activeEntry, bar_index + 1, activeEntry, xloc=xloc.bar_index, color=cEntry, width=2)
    slLine := line.new(bar_index, activeSL, bar_index + 1, activeSL, xloc=xloc.bar_index, color=cSL, width=2)
    tpLine := line.new(bar_index, activeTP, bar_index + 1, activeTP, xloc=xloc.bar_index, color=cTP, width=2)
    entryLbl := label.new(bar_index, activeEntry, "ENTRY", xloc=xloc.bar_index, style=label.style_label_left, color=cEntry, textcolor=color.black, size=size.tiny)
    slLbl := label.new(bar_index, activeSL, "SL", xloc=xloc.bar_index, style=label.style_label_left, color=cSL, textcolor=color.white, size=size.tiny)
    tpLbl := label.new(bar_index, activeTP, "TP", xloc=xloc.bar_index, style=label.style_label_left, color=cTP, textcolor=color.black, size=size.tiny)

if activeSide != "NONE" and levelStatus == "ACTIVE"
    if not na(entryLine)
        line.set_x2(entryLine, bar_index)
    if not na(slLine)
        line.set_x2(slLine, bar_index)
    if not na(tpLine)
        line.set_x2(tpLine, bar_index)
    if not na(entryLbl)
        label.set_x(entryLbl, bar_index)
    if not na(slLbl)
        label.set_x(slLbl, bar_index)
    if not na(tpLbl)
        label.set_x(tpLbl, bar_index)

if activeSide != "NONE" and levelStatus == "ACTIVE" and bar_index > signalBar
    hitSL = activeSide == "LONG" ? low <= activeSL : high >= activeSL
    hitTP = activeSide == "LONG" ? high >= activeTP : low <= activeTP

    if hitSL and hitTP
        levelStatus := "SL HIT"
        lastResult := "SL"
        exitBar := bar_index
    else if hitSL
        levelStatus := "SL HIT"
        lastResult := "SL"
        exitBar := bar_index
    else if hitTP
        levelStatus := "TP HIT"
        lastResult := "TP"
        exitBar := bar_index

    if levelStatus != "ACTIVE"
        if not na(entryLine)
            line.set_x2(entryLine, bar_index)
        if not na(slLine)
            line.set_x2(slLine, bar_index)
        if not na(tpLine)
            line.set_x2(tpLine, bar_index)
        resultLbl := label.new(bar_index, lastResult == "TP" ? activeTP : activeSL, lastResult == "TP" ? "TP HIT" : "SL HIT", xloc=xloc.bar_index, style=label.style_label_left, color=lastResult == "TP" ? cTP : cSL, textcolor=lastResult == "TP" ? color.black : color.white, size=size.small)
        activeSide := "NONE"
        activeEntry := na
        activeSL := na
        activeTP := na
        signalBar := na

plot(showMainLines ? ema20 : na, "EMA20", color=cEma20, linewidth=2)
plot(showMainLines ? ema50 : na, "EMA50", color=cEma50, linewidth=2)
plot(showMainLines ? vwap : na, "VWAP", color=cVWAP, linewidth=2)
plot(showHTFLines ? h1E21 : na, "1H EMA21", color=cH1, linewidth=2, style=plot.style_stepline)
plot(showHTFLines ? h4E21 : na, "4H EMA21", color=cH4, linewidth=2, style=plot.style_stepline)
bgcolor(showBackground ? trendLong ? color.new(cLong,92) : trendShort ? color.new(cShort,92) : na : na)
plotshape(showSignals and newLongSignal, title="V15 LONG", style=shape.labelup, text="V15\nLONG", location=location.belowbar, size=size.small, color=cLong, textcolor=color.black)
plotshape(showSignals and newShortSignal, title="V15 SHORT", style=shape.labeldown, text="V15\nSHORT", location=location.abovebar, size=size.small, color=cShort, textcolor=color.white)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(newLongSignal, "SAM EDGE V15 LONG", "SAM EDGE V15 LONG | {{ticker}} | TF=15M | close={{close}}")
alertcondition(newShortSignal, "SAM EDGE V15 SHORT", "SAM EDGE V15 SHORT | {{ticker}} | TF=15M | close={{close}}")

if barstate.isconfirmed and newLongSignal
    alert("SAM EDGE V15 LONG | " + syminfo.ticker + " | TF=15M | ENTRY=" + str.tostring(close, format.mintick) + " | SL=" + str.tostring(longSL, format.mintick) + " | TP=" + str.tostring(longTP, format.mintick) + " | RR=" + str.tostring(rr, "#.##") + " | CORE=V15_ADX4H_CANDLE2H", alert.freq_once_per_bar_close)

if barstate.isconfirmed and newShortSignal
    alert("SAM EDGE V15 SHORT | " + syminfo.ticker + " | TF=15M | ENTRY=" + str.tostring(close, format.mintick) + " | SL=" + str.tostring(shortSL, format.mintick) + " | TP=" + str.tostring(shortTP, format.mintick) + " | RR=" + str.tostring(rr, "#.##") + " | CORE=V15_ADX4H_CANDLE2H", alert.freq_once_per_bar_close)

if barstate.isconfirmed and levelStatus == "TP HIT" and exitBar == bar_index
    alert("SAM EDGE V15 TP HIT | " + syminfo.ticker + " | TF=15M | RESULT=TP", alert.freq_once_per_bar_close)

if barstate.isconfirmed and levelStatus == "SL HIT" and exitBar == bar_index
    alert("SAM EDGE V15 SL HIT | " + syminfo.ticker + " | TF=15M | RESULT=SL", alert.freq_once_per_bar_close)

// ============================================================================
// DETAILED V15 FILTER DASHBOARD
// OK = filter passes. - = filter does not pass.
// ============================================================================
var table dash = table.new(position.top_right, 4, 16, border_width=1, frame_color=color.new(color.white, 88))
f_mark(_ok) => _ok ? "OK" : "-"
f_mark_color(_ok) => _ok ? cPass : cFail
f_val(_x) => na(_x) ? "-" : str.tostring(_x, "#.##")
rsiLongOK = rsi >= 46 and rsi <= 64
rsiShortOK = rsi >= 36 and rsi <= 54

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "SAM EDGE V15", text_color=color.white, bgcolor=cPanel, text_size=size.small)
    table.cell(dash, 1, 0, "LONG", text_color=cLong, bgcolor=cPanel, text_size=size.small)
    table.cell(dash, 2, 0, "SHORT", text_color=cShort, bgcolor=cPanel, text_size=size.small)
    table.cell(dash, 3, 0, "VALUE", text_color=cEntry, bgcolor=cPanel, text_size=size.small)

    table.cell(dash, 0, 1, "STATE", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 1, activeSide == "LONG" ? "ACTIVE" : activeSide == "NONE" ? "READY" : "LOCK", text_color=activeSide == "LONG" ? cLong : cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 1, activeSide == "SHORT" ? "ACTIVE" : activeSide == "NONE" ? "READY" : "LOCK", text_color=activeSide == "SHORT" ? cShort : cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 1, activeSide == "NONE" ? lastResult : "LOCK", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 2, "1H TREND", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 2, f_mark(h1Bull), text_color=f_mark_color(h1Bull), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 2, f_mark(h1Bear), text_color=f_mark_color(h1Bear), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 2, "EMA21/50/200", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 3, "4H TREND", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 3, f_mark(h4Bull), text_color=f_mark_color(h4Bull), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 3, f_mark(h4Bear), text_color=f_mark_color(h4Bear), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 3, "EMA21/50/200", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 4, "EMA20/50", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 4, f_mark(emaLong), text_color=f_mark_color(emaLong), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 4, f_mark(emaShort), text_color=f_mark_color(emaShort), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 4, "CLOSE vs EMA20", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 5, "VWAP", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 5, f_mark(close > vwap), text_color=f_mark_color(close > vwap), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 5, f_mark(close < vwap), text_color=f_mark_color(close < vwap), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 5, f_val(vwap), text_color=color.white, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 6, "DMI", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 6, f_mark(pdi > mdi), text_color=f_mark_color(pdi > mdi), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 6, f_mark(mdi > pdi), text_color=f_mark_color(mdi > pdi), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 6, "+DI " + f_val(pdi) + " / -DI " + f_val(mdi), text_color=color.white, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 7, "RSI", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 7, f_mark(rsiLongOK), text_color=f_mark_color(rsiLongOK), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 7, f_mark(rsiShortOK), text_color=f_mark_color(rsiShortOK), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 7, f_val(rsi), text_color=color.white, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 8, "4H ADX PCTL", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 8, f_mark(adxLongOK), text_color=f_mark_color(adxLongOK), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 8, f_mark(adxShortOK), text_color=f_mark_color(adxShortOK), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 8, f_val(h4AdxPct * 100) + "%", text_color=color.white, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 9, "4H ADX DELTA", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 9, f_mark(h4AdxDelta >= adxLongDelta), text_color=f_mark_color(h4AdxDelta >= adxLongDelta), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 9, f_mark(h4AdxDelta >= adxShortDelta), text_color=f_mark_color(h4AdxDelta >= adxShortDelta), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 9, f_val(h4AdxDelta), text_color=color.white, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 10, "ROOM", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 10, f_mark(roomLong), text_color=f_mark_color(roomLong), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 10, f_mark(roomShort), text_color=f_mark_color(roomShort), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 10, "R " + f_val(distResATR) + " / S " + f_val(distSupATR), text_color=color.white, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 11, "NO EXHAUSTION", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 11, f_mark(noExhaustion), text_color=f_mark_color(noExhaustion), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 11, f_mark(noExhaustion), text_color=f_mark_color(noExhaustion), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 11, "MOVE " + f_val(move5ATR) + "ATR", text_color=color.white, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 12, "2H CANDLE", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 12, f_mark(c2hBull), text_color=f_mark_color(c2hBull), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 12, f_mark(c2hBear), text_color=f_mark_color(c2hBear), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 12, "STRICT", text_color=color.white, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 13, "STRUCTURE", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 13, f_mark(structureLong), text_color=f_mark_color(structureLong), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 13, f_mark(structureShort), text_color=f_mark_color(structureShort), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 13, "HTF+EMA+DMI+RSI", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 14, "FINAL SIGNAL", text_color=cEntry, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 14, f_mark(longSignalRaw), text_color=f_mark_color(longSignalRaw), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 14, f_mark(shortSignalRaw), text_color=f_mark_color(shortSignalRaw), bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 14, "WAIT / FIRE", text_color=cEntry, bgcolor=cPanel, text_size=size.tiny)

    table.cell(dash, 0, 15, "ADX / ATR", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 1, 15, f_val(h4Adx), text_color=color.white, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 2, 15, f_val(atr), text_color=color.white, bgcolor=cPanel, text_size=size.tiny)
    table.cell(dash, 3, 15, "4H ADX / 15M ATR", text_color=cMuted, bgcolor=cPanel, text_size=size.tiny)
